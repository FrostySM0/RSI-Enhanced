{
  "manifest_version": 3,
  "name": "RSI Enhanced",
  "version": "1.0.0",
  "minimum_chrome_version": "118",
  "host_permissions": [
    "https://docs.google.com/*"
  ],
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "description": "An RSI Spectrum theme with tools for the Hangar, Ship Matrix, Comm-Link, Dev Tracker, Funding Goals and Roadmap.",
  "action": {
    "default_title": "RSI Enhanced",
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://robertsspaceindustries.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://robertsspaceindustries.com/spectrum/*"
      ],
      "css": [
        "spectrum.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://robertsspaceindustries.com/*"
      ],
      "exclude_matches": [
        "https://robertsspaceindustries.com/spectrum/*"
      ],
      "css": [
        "rsi.css"
      ],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
